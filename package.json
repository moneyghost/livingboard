{
  "name": "livingboard",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source collaborative whiteboard that AI understands, via MCP",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @livingboard/server --filter @livingboard/web run dev",
    "dev:lan": "pnpm -r --parallel --filter @livingboard/server --filter @livingboard/web run dev:lan",
    "build": "pnpm --filter @livingboard/web run build",
    "start": "pnpm --filter @livingboard/server run start",
    "start:lan": "pnpm --filter @livingboard/server run start:lan",
    "typecheck": "pnpm -r run typecheck",
    "smoke": "pnpm --filter @livingboard/server run smoke",
    "livingboard": "pnpm --filter @livingboard/server exec tsx src/cli.ts"
  }
}
